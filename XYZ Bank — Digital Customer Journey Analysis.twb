      <aliases enabled='yes' />
      <column caption='Total Registered' datatype='integer' name='[Calculation_0709238183145473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([customer_id])' />
      </column>
      <column caption='Total Activated' datatype='integer' name='[Calculation_0709238183256066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF NOT ISNULL([first_transaction_date]) THEN [customer_id] END)' />
      </column>
      <column caption='Total Active' datatype='integer' name='[Calculation_0709238184370179]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [status] = &apos;Active&apos; THEN [customer_id] END)' />
      </column>
      <column caption='Funnel Metric' datatype='string' name='[Calculation_0709238184845316]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Registered&quot;' />
      </column>
      <column caption='Total Churned' datatype='integer' name='[Calculation_0709238186430469]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [status] = &apos;Churned&apos; THEN [customer_id] END)' />
      </column>
      <column caption='Total Dormant' datatype='integer' name='[Calculation_0709238186520582]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [status] = &apos;Dormant&apos; THEN [customer_id] END)' />
      </column>
      <column caption='Activation Rate' datatype='real' name='[Calculation_0709238189047815]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF NOT ISNULL([first_transaction_date]) THEN [customer_id] END) / COUNT([customer_id])' />
      </column>
      <column caption='Activated Customers' datatype='integer' name='[Calculation_0709238192562185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_activated] = 1 THEN [customer_id] END)' />
      </column>
      <column caption='Revenue Churned' datatype='real' name='[Calculation_0709238194085898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [status] = &apos;Churned&apos; THEN [total_value_ksh] END)' />
      </column>
      <column caption='Revenue Dormant' datatype='real' name='[Calculation_0709238194155531]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [status] = &apos;Dormant&apos; THEN [total_value_ksh] END)' />
      </column>
